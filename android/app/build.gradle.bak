plugins {
    id("com.android.application")
    // START: FlutterFire Configuration
    id("com.google.gms.google-services")
    // END: FlutterFire Configuration
    id("kotlin-android")
    // The Flutter Gradle Plugin must be applied after the Android and Kotlin Gradle plugins.
    id("dev.flutter.flutter-gradle-plugin")
}


buildscript {
    ext.kotlin_version = '1.9.20'  // Change from 1.9.20 to 1.7.10
    repositories {
        google()
        mavenCentral()
    }
    dependencies {
        classpath "org.jetbrains.kotlin:kotlin-gradle-plugin:$kotlin_version"

    }
}
android {
    namespace = "com.kaascan.application"
    compileSdk = flutter.compileSdkVersion
    ndkVersion = flutter.ndkVersion

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_11
        targetCompatibility = JavaVersion.VERSION_11
    }

    aaptOptions {
        noCompress("tflite", "lite")
    }

    kotlinOptions {
        jvmTarget = JavaVersion.VERSION_11.toString()
    }

    defaultConfig {
        applicationId = "com.kaascan.application"
        minSdk = flutter.minSdkVersion // Explicitly set to 21 to support Android 8.1 (API 27) for Wiseasy POS
        targetSdk = flutter.targetSdkVersion
        versionCode = flutter.versionCode
        versionName = flutter.versionName
        multiDexEnabled = true  // Enable MultiDex for Android Go devices
    }

    // Split APKs by ABI to reduce app size for low-end devices
    splits {
        abi {
            isEnable = true
            reset()
            include("armeabi-v7a", "arm64-v8a", "x86_64")
            isUniversalApk = true
        }
    }

    flavorDimensions += "services"

    productFlavors {
        create("gms") {
            dimension = "services"
            isDefault = true  // Set as default so flutter run works without --flavor flag
        }
        create("nogms") {
            dimension = "services"
            // Optional: Add a suffix to distinguish the installed app if needed
            // applicationIdSuffix = ".nogms"
        }
    }

    signingConfigs {
        create("release") {
            storeFile = file("new-upload-key.jks")
            storePassword = "0790467621"
            keyAlias = "upload"
            keyPassword = "0790467621"
        }
    }

    buildTypes {
        getByName("release") {
            signingConfig = signingConfigs.getByName("release")
            isMinifyEnabled = true
            isShrinkResources = false
            proguardFiles(
                getDefaultProguardFile("proguard-android-optimize.txt"),
                "proguard-rules.pro"
            )
        }
    }
    dependencies {
        implementation(fileTree(mapOf("dir" to "libs", "include" to listOf("*.jar"))))
    }
}

flutter {
    source = "../.."
}
