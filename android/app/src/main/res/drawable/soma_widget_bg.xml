<?xml version="1.0" encoding="utf-8"?>
<!-- Somakadi blue card: a deep gradient with two soft circles for depth. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#0016B8"
                android:centerColor="#0022FF"
                android:startColor="#3D5BFF"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Large glow, top right -->
    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="top|end"
        android:right="-80dp"
        android:top="-110dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
    <!-- Warm orange accent, bottom left: the robot's colour -->
    <item
        android:width="140dp"
        android:height="140dp"
        android:gravity="bottom|start"
        android:bottom="-80dp"
        android:left="-50dp">
        <shape android:shape="oval">
            <solid android:color="#33FF3C00" />
        </shape>
    </item>
    <!-- Hairline edge so it reads on any wallpaper -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
