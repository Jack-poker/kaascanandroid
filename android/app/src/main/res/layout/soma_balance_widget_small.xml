<?xml version="1.0" encoding="utf-8"?>
<!-- Somakadi widget, compact 4x1 strip: robot, balance, Soma, top-up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/soma_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:contentDescription="Soma AI"
            android:src="@drawable/soma_robot_face" />

            <TextView
                android:id="@+id/widget_msg_badge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/soma_widget_badge_bg"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="16dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/gilroy_light"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Total balance"
            android:textColor="#BFFFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/gilroy_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="12,000"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/widget_currency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/gilroy_light"
                android:includeFontPadding="false"
                android:paddingBottom="2dp"
                android:text="RWF"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_ask_button"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:background="@drawable/soma_widget_button_bg"
        android:fontFamily="@font/gilroy_semibold"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="Ask Soma"
        android:textColor="#0019CD"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/widget_topup_button"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/soma_widget_glass_circle"
        android:contentDescription="Top up"
        android:padding="10dp"
        android:src="@drawable/soma_widget_plus" />
</LinearLayout>
