<?xml version="1.0" encoding="utf-8"?>
<!-- Somakadi widget, 4x2: brand row, balance, and the two actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/soma_widget_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Brand row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="32dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|start"
                android:contentDescription="Soma AI"
                android:src="@drawable/soma_robot_face" />

            <TextView
                android:id="@+id/widget_msg_badge"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_gravity="top|end"
                android:background="@drawable/soma_widget_badge_bg"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="15dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/gilroy_semibold"
            android:text="Somakadi"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/soma_widget_chip_bg"
            android:fontFamily="@font/gilroy_light"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Wallet"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp" />

        <!-- Shown instead of the time chip while a child's message waits. -->
        <LinearLayout
            android:id="@+id/widget_msg_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/soma_widget_msg_chip_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/soma_widget_mail" />

            <TextView
                android:id="@+id/widget_msg_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:fontFamily="@font/gilroy_semibold"
                android:includeFontPadding="false"
                android:maxWidth="150dp"
                android:maxLines="1"
                android:text="Keza 2,000 RWF"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="6dp" />

    <!-- Balance -->
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gilroy_light"
        android:text="Total balance"
        android:textColor="#BFFFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/gilroy_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="12,000"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/widget_currency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/gilroy_light"
            android:includeFontPadding="false"
            android:paddingBottom="4dp"
            android:text="RWF"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_ask_button"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/soma_widget_button_bg"
            android:contentDescription="Baza Soma AI"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/soma_robot_face" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_ask_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gilroy_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Ask Soma AI"
                    android:textColor="#0019CD"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_ask_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/gilroy_light"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="about your child"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_topup_button"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/soma_widget_glass_circle"
            android:contentDescription="Top up"
            android:padding="13dp"
            android:src="@drawable/soma_widget_plus" />
    </LinearLayout>
</LinearLayout>
